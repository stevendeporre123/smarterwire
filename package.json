{
  "name": "smarterwire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "ai": "npx wrangler dev",
    "deploy": "npm run build && npm run db:migrate && npx wrangler deploy",
    "db:migrate": "npx wrangler d1 migrations apply smarterwire --remote"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.1.0",
    "lucide": "^0.469.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
