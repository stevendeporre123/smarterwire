{
  "name": "smarterwire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "ai": "npx wrangler dev -c cloudflare/wrangler.toml",
    "deploy": "npm run build && npx wrangler deploy -c cloudflare/wrangler.toml",
    "dev:app": "vite --mode app"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.1.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "lucide": "^0.469.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.3.4"
  }
}
