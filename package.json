{
  "name": "smarterwire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p cloudflare && vite build",
    "preview": "vite preview",
    "ai": "npx wrangler dev -c cloudflare/wrangler.toml",
    "deploy": "npm run build && npm run db:migrate && npx wrangler deploy -c cloudflare/wrangler.toml",
    "db:migrate": "npx wrangler d1 migrations apply smarterwire --remote -c cloudflare/wrangler.toml"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.1.0",
    "lucide": "^0.469.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
